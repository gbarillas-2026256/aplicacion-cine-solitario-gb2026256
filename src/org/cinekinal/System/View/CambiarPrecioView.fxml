<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="980.0" stylesheets="@../styles/ManageUsersStyles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cinekinal.system.controller.CambiarPrecioController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <HBox maxHeight="6.0" minHeight="6.0" prefHeight="6.0" styleClass="eva-hazard-strip" />
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="12.0" styleClass="header">
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
               <children>
                  <Label styleClass="header-titulo" text="NERV CINE · AJUSTE TARIFARIO / CAMBIO DE PRECIOS" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#onBack" styleClass="boton-volver" text="◄ VOLVER" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <HBox spacing="16.0" styleClass="area-central" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <!-- Tabla de funciones vigentes -->
            <VBox spacing="12.0" styleClass="tarjeta-tabla" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
               </padding>
               <children>
                  <Label styleClass="tarjeta-titulo" text="FUNCIONES Y PRECIOS VIGENTES" />
                  <Label styleClass="eva-subtitle" text="Selecciona una función de la lista para actualizar o solicitar ajuste a su precio base." />
                  <TableView fx:id="tableFunciones" styleClass="tabla-usuarios" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colPelicula" prefWidth="250.0" text="PELÍCULA" />
                        <TableColumn fx:id="colSala" prefWidth="150.0" text="SALA" />
                        <TableColumn fx:id="colFecha" prefWidth="110.0" text="FECHA" />
                        <TableColumn fx:id="colHora" prefWidth="90.0" text="HORA" />
                        <TableColumn fx:id="colPrecioActual" prefWidth="120.0" text="PRECIO ACTUAL" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

            <!-- Panel de modificación de precio -->
            <VBox maxWidth="350.0" minWidth="300.0" prefWidth="320.0" spacing="14.0" styleClass="tarjeta-form">
               <padding>
                  <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
               </padding>
               <children>
                  <Label styleClass="tarjeta-titulo" text="MODIFICAR TARIFA" />

                  <VBox spacing="6.0" style="-fx-background-color: #202226; -fx-padding: 12; -fx-border-color: #33352E; -fx-border-width: 1;">
                     <children>
                        <Label fx:id="lblPeliculaSel" style="-fx-text-fill: #FF6A13; -fx-font-weight: bold; -fx-font-size: 13px;" text="Película: —" wrapText="true" />
                        <Label fx:id="lblHorarioSel" style="-fx-text-fill: #ECEDE9; -fx-font-size: 12px;" text="Horario: —" />
                        <Label fx:id="lblPrecioBaseSel" style="-fx-text-fill: #FFD500; -fx-font-size: 13px; -fx-font-weight: bold;" text="Precio actual: —" />
                     </children>
                  </VBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="eva-label" text="NUEVO PRECIO BASE (Q):" />
                        <TextField fx:id="txtNuevoPrecio" promptText="Ej. 35.00" styleClass="eva-field" />
                     </children>
                  </VBox>

                  <Label fx:id="lblNotaPermiso" style="-fx-text-fill: #9AA095; -fx-font-size: 11px;" text="Si eres Gerente, el cambio enviará una solicitud al Dueño. Si eres Dueño, se aplicará al instante." wrapText="true" />

                  <Region VBox.vgrow="ALWAYS" />

                  <Button fx:id="btnAplicarPrecio" disable="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#onAplicarPrecio" styleClass="eva-button-primary" text="ACTUALIZAR PRECIO">
                     <padding>
                        <Insets bottom="12.0" top="12.0" />
                     </padding>
                  </Button>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
