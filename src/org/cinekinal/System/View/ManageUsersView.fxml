<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="960.0" stylesheets="@../styles/ManageUsersStyles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cinekinal.system.controller.ManageUsersController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <HBox maxHeight="6.0" minHeight="6.0" prefHeight="6.0" styleClass="eva-hazard-strip" />
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="12.0" styleClass="header">
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
               <children>
                  <Label styleClass="header-titulo" text="NERV CINE · GESTIÓN DE PERSONAL Y SUBORDINADOS" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#onBack" styleClass="boton-volver" text="◄ VOLVER" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="16.0" styleClass="area-central" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <VBox spacing="14.0" styleClass="tarjeta-tabla" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <VBox spacing="3.0">
                           <children>
                              <Label styleClass="tarjeta-titulo" text="PERSONAL Y SUBORDINADOS ACTIVOS" />
                              <Label styleClass="eva-subtitle" text="Selecciona un empleado para gestionarlo (editar, dar de baja o reportar), o agrega uno nuevo." />
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onAgregarEmpleado" styleClass="eva-button-primary" text="+ AGREGAR EMPLEADO">
                           <padding>
                              <Insets bottom="9.0" left="18.0" right="18.0" top="9.0" />
                           </padding>
                        </Button>
                     </children>
                  </HBox>
                  <TableView fx:id="tableUsers" onMouseClicked="#onTableClicked" styleClass="tabla-usuarios" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colUser" prefWidth="140.0" text="USUARIO" />
                        <TableColumn fx:id="colFullName" prefWidth="280.0" text="NOMBRE COMPLETO" />
                        <TableColumn fx:id="colEmail" prefWidth="280.0" text="CORREO ELECTRÓNICO" />
                        <TableColumn fx:id="colPuesto" prefWidth="180.0" text="PUESTO / ROL" />
                     </columns>
                  </TableView>
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Label fx:id="lblStatus" styleClass="status-hint" text="Ningún empleado seleccionado. Haz clic en una fila para seleccionarlo." />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnGestionarEmpleado" disable="true" mnemonicParsing="false" onAction="#onGestionarEmpleado" styleClass="boton-gestionar" text="⚙ GESTIONAR EMPLEADO" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
