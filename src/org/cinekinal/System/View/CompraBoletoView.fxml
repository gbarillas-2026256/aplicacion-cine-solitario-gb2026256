<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="640.0" prefWidth="900.0" stylesheets="@../styles/LoginStyles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.cinekinal.system.controller.CompraBoletoController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="panel-formulario">
            <padding>
                <Insets bottom="18.0" left="30.0" right="30.0" top="18.0" />
            </padding>
            <children>
                <Label styleClass="eva-title" text="COMPRAR BOLETOS" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onMouseClicked="#onVolver" styleClass="eva-button-ghost" text="VOLVER" />
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="14.0" styleClass="panel-formulario" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="10.0" />
            </padding>
            <children>
                <Label styleClass="eva-label" text="1. ELIGE UNA FUNCIÓN" />
                <TableView fx:id="tablaCartelera" prefHeight="170.0">
                    <columns>
                        <TableColumn fx:id="colPelicula" prefWidth="240.0" text="PELÍCULA" />
                        <TableColumn fx:id="colSala" prefWidth="140.0" text="SALA" />
                        <TableColumn fx:id="colFecha" prefWidth="120.0" text="FECHA" />
                        <TableColumn fx:id="colHora" prefWidth="100.0" text="HORA" />
                        <TableColumn fx:id="colPrecio" prefWidth="100.0" text="PRECIO" />
                    </columns>
                </TableView>

                <Label styleClass="eva-label" text="2. ELIGE UN ASIENTO LIBRE" />
                <ScrollPane fitToWidth="true" prefHeight="220.0" styleClass="panel-formulario">
                    <content>
                        <GridPane fx:id="gridAsientos" alignment="CENTER" hgap="6.0" vgap="6.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </GridPane>
                    </content>
                </ScrollPane>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label fx:id="lblSeleccion" styleClass="eva-subtitle" text="Ningún asiento seleccionado" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onMouseClicked="#onComprar" styleClass="eva-button-primary" text="COMPRAR" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
