<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="700.0" prefWidth="1000.0" stylesheets="@../styles/LoginStyles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.cinekinal.system.controller.CorteCajaController">
    <top>
        <VBox styleClass="panel-formulario">
            <padding>
                <Insets bottom="16.0" left="30.0" right="30.0" top="18.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label styleClass="eva-title" text="CORTE DE CAJA" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onVolver" styleClass="eva-button-ghost" text="VOLVER" />
                    </children>
                </HBox>
                <HBox spacing="30.0">
                    <padding>
                        <Insets top="8.0" />
                    </padding>
                    <children>
                        <Label styleClass="eva-subtitle" text="Empleado:" />
                        <Label fx:id="lblEmpleado" styleClass="dato-valor" text="-" />
                        <Label styleClass="eva-subtitle" text="Fecha:" />
                        <Label fx:id="lblFecha" styleClass="dato-valor" text="-" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="panel-formulario" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="20.0" left="30.0" right="30.0" top="16.0" />
                    </padding>
                    <children>

                        <!-- ENTRADAS: se calculan solas de la tabla Boletos -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="1. ENTRADAS VENDIDAS HOY (calculado por el sistema)" />
                                <Label styleClass="eva-subtitle" text="Esto NO se captura a mano: sale de los boletos ya registrados en el sistema." />
                                <TableView fx:id="tablaEntradas" prefHeight="150.0">
                                    <columns>
                                        <TableColumn fx:id="colPelicula" prefWidth="450.0" text="PELÍCULA" />
                                        <TableColumn fx:id="colBoletos" prefWidth="150.0" text="BOLETOS" />
                                        <TableColumn fx:id="colTotalPelicula" prefWidth="180.0" text="TOTAL" />
                                    </columns>
                                </TableView>
                                <HBox spacing="20.0">
                                    <children>
                                        <Label styleClass="eva-subtitle" text="Boletos vendidos:" />
                                        <Label fx:id="lblBoletosVendidos" styleClass="dato-valor" text="0" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- DULCERIA: lo que el empleado captura -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="2. DULCERÍA Y COMESTIBLES (captura manual)" />
                                <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                                    <children>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="eva-label" text="CATEGORÍA" />
                                                <ComboBox fx:id="cmbCategoria" prefWidth="160.0" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="eva-label" text="DESCRIPCIÓN" />
                                                <TextField fx:id="txtDescripcion" maxWidth="Infinity" promptText="ej: Combo grande 2 palomitas + 2 bebidas" styleClass="eva-field" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="eva-label" text="CANTIDAD" />
                                                <TextField fx:id="txtCantidad" prefWidth="90.0" promptText="0" styleClass="eva-field" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="eva-label" text="PRECIO UNIT." />
                                                <TextField fx:id="txtPrecioUnitario" prefWidth="110.0" promptText="0.00" styleClass="eva-field" />
                                            </children>
                                        </VBox>
                                        <Button mnemonicParsing="false" onAction="#onAgregarLinea" styleClass="eva-button-primary" text="AGREGAR" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tablaDulceria" prefHeight="180.0">
                                    <columns>
                                        <TableColumn fx:id="colCategoria" prefWidth="140.0" text="CATEGORÍA" />
                                        <TableColumn fx:id="colDescripcion" prefWidth="330.0" text="DESCRIPCIÓN" />
                                        <TableColumn fx:id="colCantidad" prefWidth="90.0" text="CANT." />
                                        <TableColumn fx:id="colPrecioUnitario" prefWidth="120.0" text="P. UNIT." />
                                        <TableColumn fx:id="colSubtotal" prefWidth="120.0" text="SUBTOTAL" />
                                    </columns>
                                </TableView>
                                <HBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#onQuitarLinea" styleClass="eva-button-ghost" text="QUITAR LÍNEA SELECCIONADA" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- REPORTE DE SUCESOS E INCIDENCIAS DEL TURNO -->
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="eva-label" text="📝 MENSAJE DEL TURNO / REPORTE DE SUCESOS E INCIDENCIAS" />
                                <TextArea fx:id="txtObservaciones" prefHeight="75.0" promptText="Escribe aquí el reporte del turno: incidencias con clientes, cuadre de caja, fallas técnicas en salas o notas generales para el Dueño..." styleClass="eva-field" wrapText="true" />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox styleClass="panel-formulario">
            <padding>
                <Insets bottom="18.0" left="30.0" right="30.0" top="16.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="eva-label" text="ENTRADAS" />
                                <Label fx:id="lblTotalEntradas" styleClass="dato-valor" text="Q 0.00" />
                            </children>
                        </VBox>
                        <Label styleClass="eva-title" text="+" />
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="eva-label" text="DULCERÍA" />
                                <Label fx:id="lblTotalDulceria" styleClass="dato-valor" text="Q 0.00" />
                            </children>
                        </VBox>
                        <Label styleClass="eva-title" text="=" />
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="eva-label" text="TOTAL DEL DÍA" />
                                <Label fx:id="lblTotalGeneral" styleClass="eva-title" text="Q 0.00" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onCerrarCorte" styleClass="eva-button-primary" text="CERRAR CORTE Y ENVIAR" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>
